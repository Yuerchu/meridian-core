          "credential_kind": "codex_cli",
          "transport_profile": "chatgpt_codex",
          "api_formats": ["responses"],
          "default_base_url": {
            "responses": "https://chatgpt.com/backend-api/codex"
          }
        }
      ],
      "models": []
    },
